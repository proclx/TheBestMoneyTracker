<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="AppBackground" Color="#F0F2F5"/>
    <SolidColorBrush x:Key="WindowBackground" Color="White"/>
    
    <SolidColorBrush x:Key="PrimaryText" Color="Black"/>
    <SolidColorBrush x:Key="SecondaryText" Color="#555555"/>
    
    <SolidColorBrush x:Key="ButtonBackground" Color="#007AFF"/>
    <SolidColorBrush x:Key="ButtonForeground" Color="White"/>

    <SolidColorBrush x:Key="BorderColor" Color="#D1D1D1"/>

</ResourceDictionary>