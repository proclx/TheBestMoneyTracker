<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="AppBackground" Color="#121212"/>
    <SolidColorBrush x:Key="WindowBackground" Color="#1E1E1E"/>

    <SolidColorBrush x:Key="PrimaryText" Color="White"/>
    <SolidColorBrush x:Key="SecondaryText" Color="#AAAAAA"/>

    <SolidColorBrush x:Key="ButtonBackground" Color="#0A84FF"/>
    <SolidColorBrush x:Key="ButtonForeground" Color="White"/>
    
    <SolidColorBrush x:Key="BorderColor" Color="#444444"/>

</ResourceDictionary>