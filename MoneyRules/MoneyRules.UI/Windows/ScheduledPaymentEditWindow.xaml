<Window x:Class="MoneyRules.UI.Windows.ScheduledPaymentEditWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Edit Scheduled Payment" Height="400" Width="400">
  <Grid Margin="10">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <StackPanel>
      <TextBlock Text="Description" />
      <TextBox x:Name="TxtDescription" />
      <TextBlock Text="Amount" />
      <TextBox x:Name="TxtAmount" />
      <TextBlock Text="Frequency" />
      <ComboBox x:Name="CmbFrequency">
        <ComboBoxItem Content="OneTime" Tag="0" />
        <ComboBoxItem Content="Daily" Tag="1" />
        <ComboBoxItem Content="Weekly" Tag="2" />
        <ComboBoxItem Content="Monthly" Tag="3" />
        <ComboBoxItem Content="Yearly" Tag="4" />
      </ComboBox>
      <TextBlock Text="Interval" />
      <TextBox x:Name="TxtInterval" />
      <TextBlock Text="Start Date" />
      <DatePicker x:Name="DpStart" />
      <TextBlock Text="End Date (optional)" />
      <DatePicker x:Name="DpEnd" />
      <TextBlock Text="Category" />
      <ComboBox x:Name="CmbCategory" />
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
        <Button Content="Save" Width="80" Click="Save_Click" Margin="0,0,8,0" />
        <Button Content="Cancel" Width="80" Click="Cancel_Click" />
      </StackPanel>
    </StackPanel>
  </Grid>
</Window>