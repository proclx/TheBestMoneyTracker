<Window x:Class="MoneyRules.UI.Windows.ScheduledPaymentEditWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Edit Scheduled Payment" Width="520" SizeToContent="Height">
  <Border Style="{StaticResource CardStyle}" Margin="10">
    <Grid Margin="8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" MinWidth="120" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <TextBlock Text="Опис" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Margin="0,4,8,4"/>
      <TextBox x:Name="TxtDescription" Grid.Row="0" Grid.Column="1" />

      <TextBlock Text="Сума" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Margin="0,4,8,4"/>
      <TextBox x:Name="TxtAmount" Grid.Row="1" Grid.Column="1" />

      <TextBlock Text="Частота" Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Margin="0,4,8,4"/>
      <ComboBox x:Name="CmbFrequency" Grid.Row="2" Grid.Column="1">
        <ComboBoxItem Content="OneTime" Tag="0" />
        <ComboBoxItem Content="Daily" Tag="1" />
        <ComboBoxItem Content="Weekly" Tag="2" />
        <ComboBoxItem Content="Monthly" Tag="3" />
        <ComboBoxItem Content="Yearly" Tag="4" />
      </ComboBox>

      <TextBlock Text="Інтервал" Grid.Row="3" Grid.Column="0" VerticalAlignment="Center" Margin="0,4,8,4"/>
      <TextBox x:Name="TxtInterval" Grid.Row="3" Grid.Column="1" />

      <TextBlock Text="Початок" Grid.Row="4" Grid.Column="0" VerticalAlignment="Center" Margin="0,4,8,4"/>
      <DatePicker x:Name="DpStart" Grid.Row="4" Grid.Column="1" />

      <TextBlock Text="Кінець (опційно)" Grid.Row="5" Grid.Column="0" VerticalAlignment="Center" Margin="0,4,8,4"/>
      <DatePicker x:Name="DpEnd" Grid.Row="5" Grid.Column="1" />

      <TextBlock Text="Категорія" Grid.Row="6" Grid.Column="0" VerticalAlignment="Center" Margin="0,4,8,4"/>
      <ComboBox x:Name="CmbCategory" Grid.Row="6" Grid.Column="1" />

      <StackPanel Grid.Row="7" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
        <Button Content="Зберегти" Width="100" Click="Save_Click" Margin="0,0,8,0" Style="{StaticResource PrimaryButton}" />
        <Button Content="Скасувати" Width="100" Click="Cancel_Click" />
      </StackPanel>
    </Grid>
  </Border>
</Window>