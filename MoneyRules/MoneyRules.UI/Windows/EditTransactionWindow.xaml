<Window x:Class="MoneyRules.UI.Windows.EditTransactionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Редагування транзакції" Height="430" Width="450">

    <Border Style="{StaticResource CardStyle}" Margin="20">

        <Grid Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="140"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBlock Text="Сума:" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center"/>
            <TextBox x:Name="TxtAmount" Grid.Row="0" Grid.Column="1"/>

            <TextBlock Text="Тип:" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center"/>
            <ComboBox x:Name="CmbType" Grid.Row="1" Grid.Column="1">
                <ComboBoxItem Content="Income"/>
                <ComboBoxItem Content="Expense"/>
            </ComboBox>

            <TextBlock Text="Категорія:" Grid.Row="2" Grid.Column="0" VerticalAlignment="Center"/>
            <TextBox x:Name="TxtCategory" Grid.Row="2" Grid.Column="1"/>

            <TextBlock Text="Дата:" Grid.Row="3" Grid.Column="0" VerticalAlignment="Center"/>
            <DatePicker x:Name="DpDate" Grid.Row="3" Grid.Column="1"/>

            <TextBlock Text="Опис:" Grid.Row="4" Grid.Column="0" VerticalAlignment="Center"/>
            <TextBox x:Name="TxtDescription" Grid.Row="4" Grid.Column="1"/>

            <Button Content="Зберегти"
                    Grid.Row="5" Grid.ColumnSpan="2"
                    Margin="20,15,0,0"
                    Width="120"
                    HorizontalAlignment="Center"
                    Style="{StaticResource PrimaryButton}"
                    Click="BtnSave_Click"/>
        </Grid>

    </Border>
</Window>
