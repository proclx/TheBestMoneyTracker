<Window x:Class="MoneyRules.UI.Windows.EditTransactionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Редагування транзакції" Width="460" SizeToContent="Height">

    <Border Style="{StaticResource CardStyle}" Margin="10">

        <Grid Margin="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" MinWidth="100"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBlock Text="Сума:" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Margin="0,4,8,4"/>
            <TextBox x:Name="TxtAmount" Grid.Row="0" Grid.Column="1" MinWidth="160"/>

            <TextBlock Text="Тип:" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Margin="0,4,8,4"/>
            <ComboBox x:Name="CmbType" Grid.Row="1" Grid.Column="1" MinWidth="160">
                <ComboBoxItem Content="Income"/>
                <ComboBoxItem Content="Expense"/>
            </ComboBox>

            <TextBlock Text="Категорія:" Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Margin="0,4,8,4"/>
            <TextBox x:Name="TxtCategory" Grid.Row="2" Grid.Column="1"/>

            <TextBlock Text="Дата:" Grid.Row="3" Grid.Column="0" VerticalAlignment="Center" Margin="0,4,8,4"/>
            <DatePicker x:Name="DpDate" Grid.Row="3" Grid.Column="1"/>

            <TextBlock Text="Опис:" Grid.Row="4" Grid.Column="0" VerticalAlignment="Top" Margin="0,4,8,4"/>
            <TextBox x:Name="TxtDescription" Grid.Row="4" Grid.Column="1" Height="80" TextWrapping="Wrap" AcceptsReturn="True"/>

            <Button Content="Зберегти"
                    Grid.Row="5" Grid.ColumnSpan="2"
                    Margin="0,15,0,0"
                    Width="140"
                    HorizontalAlignment="Center"
                    Style="{StaticResource PrimaryButton}"
                    Click="BtnSave_Click"/>
        </Grid>

    </Border>
</Window>
