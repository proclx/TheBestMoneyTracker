<Window x:Class="MoneyRules.UI.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:MoneyRules.UI.Windows"
        Title="MoneyRules" Height="500" Width="700">
    <Grid>
        <TabControl x:Name="MainTabControl">
            <!-- Завантаження файлу -->
            <TabItem Header="Завантаження файлу">
                <local:FileUploadPage />
            </TabItem>

            <!-- Редагування даних -->
            <TabItem Header="Редагування даних">
                <StackPanel Margin="-12,10,32,10">
                    <TextBlock Text="Тут будуть транзакції та кнопки для редагування" Margin="5"/>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Content="Додати транзакцію" Width="150" Margin="0,0,5,0" Click="AddTransactionButton_Click"/>
                        <Button Content="Видалити" Width="100" Margin="0,0,5,0"/>
                        <Button Content="Переглянути історію" Width="200" Click="OpenHistory_Click"/>
                    </StackPanel>
                    <!-- Export PDF button moved below for better layout -->
                    <StackPanel HorizontalAlignment="Center" Margin="0,12,0,0">
                        <Button x:Name="BtnExportPdf" Content="Експорт PDF" Width="180" Height="36" Background="#1976D2" Foreground="White" FontWeight="SemiBold" Click="BtnExportPdf_Click"/>
                    </StackPanel>
                </StackPanel>
            </TabItem>

            <!-- Візуалізація -->
            <TabItem Header="Візуалізація">
                <StackPanel Margin="10">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Рік:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <ComboBox x:Name="CmbChartYear" Width="100" SelectionChanged="CmbChartYear_SelectionChanged" />
                        <TextBlock Text="Місяць:" VerticalAlignment="Center" Margin="8,0,4,0"/>
                        <ComboBox x:Name="CmbChartMonth" Width="120" SelectionChanged="CmbChartYear_SelectionChanged" />
                        <CheckBox x:Name="ChkMonthlyView" Content="Показати по днях" VerticalAlignment="Center" Margin="8,0,0,0" Checked="ChkMonthlyView_CheckedChanged" Unchecked="ChkMonthlyView_CheckedChanged" />
                        <Button Content="Оновити" Margin="8,0,0,0" Click="BtnRefreshChart_Click" />
                    </StackPanel>

                    <Border BorderBrush="Gray" BorderThickness="1" Margin="0,10,0,0" Padding="8">
                        <StackPanel>
                            <Canvas x:Name="ChartCanvas" Height="260" Background="WhiteSmoke" />
                            <TextBlock x:Name="TxtChartStatus" Margin="0,8,0,0" FontStyle="Italic"/>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Rectangle Width="16" Height="12" Fill="Green" Stroke="Black" />
                                <TextBlock Text=" Income" Margin="6,0,10,0" VerticalAlignment="Center" />
                                <Rectangle Width="16" Height="12" Fill="Red" Stroke="Black" />
                                <TextBlock Text=" Expense" Margin="6,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </TabItem>

            <!-- Підписка -->
            <TabItem Header="Підписка">
                <StackPanel Margin="10">
                    <TextBlock Text="Активація преміум-підписки" Margin="0,0,0,5"/>
                    <Button Content="Активувати підписку" Width="200"/>
                    <TextBlock Text="Тут буде статус підписки" Margin="5"/>
                </StackPanel>
            </TabItem>

            <!-- Поради -->
            <TabItem Header="Поради">
                <StackPanel Margin="10">
                    <TextBlock Text="Персональні поради на основі ваших транзакцій" FontStyle="Italic"/>
                    <GroupBox Header="Поради щодо економії" Margin="0,10,0,0">
                        <StackPanel>
                            <ItemsControl x:Name="AdviceList" />
                            <Button x:Name="RefreshAdviceButton" Content="Оновити поради" Width="150" Margin="0,8,0,0" Click="RefreshAdviceButton_Click" />
                        </StackPanel>
                    </GroupBox>
                </StackPanel>
            </TabItem>

            <!-- Профіль -->
            <TabItem Header="Профіль">
                <Grid Margin="20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Profile Photo -->
                    <StackPanel Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Top">
                        <Border BorderBrush="Gray" BorderThickness="1" CornerRadius="10" Padding="5">
                            <Image x:Name="ProfileImage" Width="150" Height="150" Stretch="UniformToFill"/>
                        </Border>
                        <Button x:Name="BtnChangePhoto" 
                                Content="Змінити фото" 
                                Margin="0,10,0,0" 
                                Click="BtnChangePhoto_Click"
                                Background="#0078D7"     
                                Foreground="White"/>
                        
                        <!-- Currency Rates Panel -->
                        <Border Background="#F5F5F5" BorderBrush="#E0E0E0" BorderThickness="1" 
                                CornerRadius="8" Margin="0,20,0,0" Width="200">
                            <StackPanel Margin="10">
                                <TextBlock Text="Курси валют" FontWeight="SemiBold" 
                                         FontSize="14" HorizontalAlignment="Center"
                                         Margin="0,0,0,10"/>
                                <TextBlock x:Name="TxtExchangeRates" TextWrapping="Wrap"
                                         FontFamily="Consolas"/>
                                <Button x:Name="BtnRefreshRates" Content="Оновити курси"
                                        Width="120" Margin="0,10,0,0"
                                        Background="#2196F3" Foreground="White"
                                        Padding="5" Click="BtnRefreshRates_Click">
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="4"/>
                                        </Style>
                                    </Button.Resources>
                                </Button>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- User Info + Settings -->
                    <StackPanel Grid.Column="1" Margin="20,0,0,0" VerticalAlignment="Top">
                        <TextBlock Text="Інформація про користувача" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>

                        <StackPanel Orientation="Horizontal" Margin="0,5">
                            <TextBlock Text="Ім'я:" Width="120" VerticalAlignment="Center"/>
                            <TextBox x:Name="TxtName" Width="250"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,5">
                            <TextBlock Text="Email:" Width="120" VerticalAlignment="Center"/>
                            <TextBox x:Name="TxtEmail" Width="250"/>
                        </StackPanel>

                        <Separator Margin="0,15,0,15"/>

                        <TextBlock Text="Налаштування" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>

                        <StackPanel Orientation="Horizontal" Margin="0,5">
                            <TextBlock Text="Валюта:" Width="120" VerticalAlignment="Center"/>
                            <ComboBox x:Name="CmbCurrency" Width="150">
                                <ComboBoxItem Content="USD"/>
                                <ComboBoxItem Content="EUR"/>
                                <ComboBoxItem Content="UAH"/>
                                <ComboBoxItem Content="GBP"/>
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,5">
                            <TextBlock Text="Сповіщення:" Width="120" VerticalAlignment="Center"/>
                            <CheckBox x:Name="ChkNotifications" Content="Enabled"/>
                        </StackPanel>
                        <!-- Save changes Button -->
                        <Button x:Name="BtnSaveProfile" 
                                Content="Зберегти зміни" 
                                Width="150" Margin="0,20,0,0" 
                                Click="BtnSaveProfile_Click"
                                Background="#FF9800"     
                                Foreground="White"/>


                        <!-- Logout Button -->
                        <Button x:Name="BtnLogout"
                                Content="Вийти з акаунту"
                                Width="150"
                                Margin="0,10,0,0"
                                Background="#E57373"
                                Foreground="White"
                                Click="BtnLogout_Click"/>

                        <!-- Change password Button -->
                        <Button x:Name="BtnChangePassword"     
                                Content="Змінити пароль"     
                                Width="150"          
                                Margin="0,10,0,0"    
                                Click="BtnChangePassword_Click"      
                                Background="#0078D7"     
                                Foreground="White"/>

                    </StackPanel>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
    
