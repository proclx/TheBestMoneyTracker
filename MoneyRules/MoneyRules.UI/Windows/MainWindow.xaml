<Window x:Class="MoneyRules.UI.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:MoneyRules.UI.Windows"
        Title="MoneyRules" Height="500" Width="700"
        Background="{DynamicResource AppBackground}">
    <Grid>
        <TabControl x:Name="MainTabControl" Background="{DynamicResource AppBackground}">
            
            <TabItem Header="Завантаження файлу" Background="{DynamicResource AppBackground}">
                <local:FileUploadPage />
            </TabItem>

            <TabItem Header="Редагування даних" Background="{DynamicResource AppBackground}">
                <!-- Використовуємо Grid для точного позиціонування панелі сповіщень унизу праворуч -->
                <Grid>
                    <!-- Основний вміст вкладки "Редагування даних" -->
                    <StackPanel Margin="-12,10,32,10">
                        <TextBlock Text="Тут будуть транзакції та кнопки для редагування" Margin="5" Foreground="{DynamicResource SecondaryText}"/>
                        
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            
                            <Button Content="Додати транзакцію" Width="150" Margin="0,0,5,0" Click="AddTransactionButton_Click" Background="{DynamicResource ButtonBackground}" Foreground="{DynamicResource ButtonForeground}"/>
                            <Button Content="Видалити" Width="100" Margin="0,0,5,0" Background="{DynamicResource ButtonBackground}" Foreground="{DynamicResource ButtonForeground}"/>
                            <Button Content="Переглянути історію" Width="160" Click="OpenHistory_Click" Background="{DynamicResource ButtonBackground}" Foreground="{DynamicResource ButtonForeground}"/>
                            <Button x:Name="BtnScheduledPayments" Content="Заплановані платежі" Width="160" Margin="8,0,0,0" Click="BtnScheduledPayments_Click" Background="{DynamicResource ButtonBackground}" Foreground="{DynamicResource ButtonForeground}"/>
                            
                            <Button x:Name="OpenDuplicatePaymentWindowButton" 
                                    Content="Дублювати платіж" 
                                    Click="OpenDuplicatePaymentWindow_Click" 
                                    Width="160" Margin="8,0,0,0" 
                                    Background="{DynamicResource ButtonBackground}" 
                                    Foreground="{DynamicResource ButtonForeground}"/>
                        
                        </StackPanel>
                        
                        <StackPanel HorizontalAlignment="Center" Margin="0,12,0,0">
                            <Button x:Name="BtnExportPdf" Content="Експорт PDF" Width="180" Height="36" FontWeight="SemiBold" Click="BtnExportPdf_Click" Background="{DynamicResource ButtonBackground}" Foreground="{DynamicResource ButtonForeground}"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- ======================================================= -->
                    <!-- ДОДАНО: Панель сповіщень про заплановані платежі -->
                    <!-- ======================================================= -->
                    <Border x:Name="NotificationPanelBorder"
                            Visibility="Collapsed" 
                            Background="{DynamicResource WindowBackground}" 
                            BorderBrush="#FFD700"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="12" 
                            Width="350"
                            HorizontalAlignment="Right" 
                            VerticalAlignment="Bottom"
                            Margin="20">

                        <StackPanel x:Name="NotificationPanelContent"> 
                            <TextBlock Text="🔔 Наближаються важливі платежі" 
                                       FontWeight="Bold" 
                                       Foreground="#B00020" 
                                       Margin="0,0,0,5"/>
                            
                            <Separator Margin="0,0,0,5"/>
                            
                            <TextBlock x:Name="NotificationText" 
                                       TextWrapping="Wrap" 
                                       Foreground="{DynamicResource PrimaryText}" 
                                       Text="Тут буде детальний список платежів."/>

                        </StackPanel>
                    </Border>
                    <!-- ======================================================= -->
                    
                </Grid>
            </TabItem>

            <TabItem Header="Візуалізація" Background="{DynamicResource AppBackground}">
                <!-- Додаємо вертикальну прокрутку для вмісту з діаграмами -->
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="10">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Рік:" VerticalAlignment="Center" Margin="0,0,4,0" Foreground="{DynamicResource PrimaryText}"/>
                        <ComboBox x:Name="CmbChartYear" Width="100" SelectionChanged="CmbChartYear_SelectionChanged" />
                        <TextBlock Text="Місяць:" VerticalAlignment="Center" Margin="8,0,4,0" Foreground="{DynamicResource PrimaryText}"/>
                        <ComboBox x:Name="CmbChartMonth" Width="120" SelectionChanged="CmbChartYear_SelectionChanged" />
                        <CheckBox x:Name="ChkMonthlyView" Content="Показати по днях" VerticalAlignment="Center" Margin="8,0,0,0" Checked="ChkMonthlyView_CheckedChanged" Unchecked="ChkMonthlyView_CheckedChanged" Foreground="{DynamicResource PrimaryText}" />
                        <Button Content="Оновити" Margin="8,0,0,0" Click="BtnRefreshChart_Click" Background="{DynamicResource ButtonBackground}" Foreground="{DynamicResource ButtonForeground}"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <TextBlock Text="Місячний бюджет:" VerticalAlignment="Center" Margin="0,0,4,0" Foreground="{DynamicResource PrimaryText}"/>

                        <TextBox Width="120" 
                            Background="{DynamicResource WindowBackground}" 
                            Foreground="{DynamicResource PrimaryText}" 
                            BorderBrush="{DynamicResource BorderColor}"
                            Text="{Binding MonthlyBudget, StringFormat=N2, UpdateSourceTrigger=PropertyChanged}"/>

                        <Button Content="Зберегти бюджет" 
                             Margin="8,0,0,0" 
                             Background="{DynamicResource ButtonBackground}" 
                             Foreground="{DynamicResource ButtonForeground}" 
                             Command="{Binding SaveBudgetCommand}"/>
                        </StackPanel>

                        <Border BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" Margin="0,10,0,0" Padding="8" Background="{DynamicResource WindowBackground}">
                        <StackPanel>
                            <Canvas x:Name="ChartCanvas" Height="260" Background="{DynamicResource AppBackground}" />
                            <TextBlock x:Name="TxtChartStatus" Margin="0,8,0,0" FontStyle="Italic" Foreground="{DynamicResource SecondaryText}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Rectangle Width="16" Height="12" Fill="Green" Stroke="Black" />
                                <TextBlock Text=" Income" Margin="6,0,10,0" VerticalAlignment="Center" Foreground="{DynamicResource PrimaryText}" />
                                <Rectangle Width="16" Height="12" Fill="Red" Stroke="Black" />
                                <TextBlock Text=" Expense" Margin="6,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource PrimaryText}" />
                            </StackPanel>

                            <Separator Margin="0,12,0,12" />
                            <TextBlock Text="Деталі за категоріями" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryText}" />
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Поле для кругових діаграм: топ-5 зверху, вибрані категорії під ним. -->
                                <StackPanel Grid.Column="0" Orientation="Vertical">
                                    <!-- Перший: Top-5 (незмінний) -->
                                    <Canvas x:Name="PieTop5Canvas" Height="220" Background="{DynamicResource AppBackground}" Margin="0,0,0,8" />
                                    <!-- Другий: вибрані категорії (через чекбокси) -->
                                    <Canvas x:Name="PieSelectedCanvas" Height="220" Background="{DynamicResource AppBackground}" Margin="0,8,0,0" />
                                </StackPanel>

                                <!-- Легенда для Top-5 -->
                                <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                    <TextBlock Text="Легенда (Top-5)" FontWeight="Bold" Foreground="{DynamicResource PrimaryText}" />
                                    <ItemsControl x:Name="PieTop5Legend" Margin="0,6,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" Margin="0,4,0,4">
                                                    <Rectangle Width="16" Height="12" Fill="{Binding Color}" Stroke="Black" />
                                                    <TextBlock Text=" " />
                                                    <TextBlock Text="{Binding Label}" VerticalAlignment="Center" Foreground="{DynamicResource PrimaryText}"/>
                                                    <TextBlock Text=" - " VerticalAlignment="Center" Foreground="{DynamicResource SecondaryText}" />
                                                    <TextBlock Text="{Binding Value}" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryText}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <Separator Margin="0,8,0,8" />

                                    <TextBlock Text="Легенда (Вибрані)" FontWeight="Bold" Foreground="{DynamicResource PrimaryText}" />
                                    <ItemsControl x:Name="PieSelectedLegend" Margin="0,6,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" Margin="0,4,0,4">
                                                    <Rectangle Width="16" Height="12" Fill="{Binding Color}" Stroke="Black" />
                                                    <TextBlock Text=" " />
                                                    <TextBlock Text="{Binding Label}" VerticalAlignment="Center" Foreground="{DynamicResource PrimaryText}"/>
                                                    <TextBlock Text=" - " VerticalAlignment="Center" Foreground="{DynamicResource SecondaryText}" />
                                                    <TextBlock Text="{Binding Value}" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryText}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Grid>
                            
                            <!-- Селектор категорій (чекбокси). Якщо нічого не вибрано, користувачу показується підказка.
                                 Користувач може обрати від 2 до 10 категорій. -->
                            <TextBlock Text="Виберіть категорії для показу (2–10):" Margin="0,12,0,4" Foreground="{DynamicResource PrimaryText}" />
                            <ScrollViewer Height="120" VerticalScrollBarVisibility="Auto">
                                <StackPanel x:Name="CategoryCheckboxes" />
                            </ScrollViewer>
                            <TextBlock x:Name="CategoryHintText" Text="Оберіть від 2 до 10 категорій для аналізу." Foreground="{DynamicResource SecondaryText}" Visibility="Collapsed" Margin="0,6,0,0" />

                            <Separator Margin="0,12,0,12" />
                            <TextBlock Text="Доходи vs Витрати" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryText}" />
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Canvas x:Name="IncomeExpenseCanvas" Grid.Column="0" Height="160" Background="{DynamicResource AppBackground}" />
                                <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                    <TextBlock Text="Легенда" FontWeight="Bold" Foreground="{DynamicResource PrimaryText}" />
                                    <ItemsControl x:Name="IncomeExpenseLegend" Margin="0,6,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" Margin="0,4,0,4">
                                                    <Rectangle Width="16" Height="12" Fill="{Binding Color}" Stroke="Black" />
                                                    <TextBlock Text=" " />
                                                    <TextBlock Text="{Binding Label}" VerticalAlignment="Center" Foreground="{DynamicResource PrimaryText}"/>
                                                    <TextBlock Text=" - " VerticalAlignment="Center" Foreground="{DynamicResource SecondaryText}" />
                                                    <TextBlock Text="{Binding Value}" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryText}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Підписка" Background="{DynamicResource AppBackground}">
                <StackPanel Margin="10">
                    <TextBlock Text="Активація преміум-підписки" Margin="0,0,0,5" Foreground="{DynamicResource PrimaryText}"/>
                    <Button Content="Активувати підписку" Width="200" Background="{DynamicResource ButtonBackground}" Foreground="{DynamicResource ButtonForeground}"/>
                    <TextBlock Text="Тут буде статус підписки" Margin="5" Foreground="{DynamicResource SecondaryText}"/>
                </StackPanel>
            </TabItem>

            <TabItem Header="Поради" Background="{DynamicResource AppBackground}">
                <StackPanel Margin="10">
                    <TextBlock Text="Персональні поради на основі ваших транзакцій" FontStyle="Italic" Foreground="{DynamicResource SecondaryText}"/>
                    <GroupBox Header="Поради щодо економії" Margin="0,10,0,0" Foreground="{DynamicResource PrimaryText}">
                        <StackPanel>
                            <ItemsControl x:Name="AdviceList" />
                            <Button x:Name="RefreshAdviceButton" Content="Оновити поради" Width="150" Margin="0,8,0,0" Click="RefreshAdviceButton_Click" Background="{DynamicResource ButtonBackground}" Foreground="{DynamicResource ButtonForeground}" />
                        </StackPanel>
                    </GroupBox>
                </StackPanel>
            </TabItem>

            <TabItem Header="Профіль" Background="{DynamicResource AppBackground}">
                <Grid Margin="20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Top">
                        <Border BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="10" Padding="5">
                            <Image x:Name="ProfileImage" Width="150" Height="150" Stretch="UniformToFill"/>
                        </Border>
                        <Button x:Name="BtnChangePhoto" 
                                Content="Змінити фото" 
                                Margin="0,10,0,0" 
                                Click="BtnChangePhoto_Click"
                                Background="{DynamicResource ButtonBackground}" 	
                                Foreground="{DynamicResource ButtonForeground}"/>
                        
                        <Border Background="{DynamicResource WindowBackground}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" 
                                CornerRadius="8" Margin="0,20,0,0" Width="200">
                            <StackPanel Margin="10">
                                <TextBlock Text="Курси валют" FontWeight="SemiBold" 
                                           FontSize="14" HorizontalAlignment="Center"
                                           Margin="0,0,0,10"
                                           Foreground="{DynamicResource PrimaryText}"/>
                                <TextBlock x:Name="TxtExchangeRates" TextWrapping="Wrap"
                                           FontFamily="Consolas"
                                           Foreground="{DynamicResource SecondaryText}"/>
                                <Button x:Name="BtnRefreshRates" Content="Оновити курси"
                                        Width="120" Margin="0,10,0,0"
                                        Background="{DynamicResource ButtonBackground}" Foreground="{DynamicResource ButtonForeground}"
                                        Padding="5" Click="BtnRefreshRates_Click">
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="4"/>
                                        </Style>
                                    </Button.Resources>
                                </Button>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="20,0,0,0" VerticalAlignment="Top">
                        <TextBlock Text="Інформація про користувача" FontSize="18" FontWeight="Bold" Margin="0,0,0,10" Foreground="{DynamicResource PrimaryText}"/>

                        <StackPanel Orientation="Horizontal" Margin="0,5">
                            <TextBlock Text="Ім'я:" Width="120" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryText}"/>
                            <TextBox x:Name="TxtName" Width="250" Background="{DynamicResource WindowBackground}" Foreground="{DynamicResource PrimaryText}" BorderBrush="{DynamicResource BorderColor}"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,5">
                            <TextBlock Text="Email:" Width="120" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryText}"/>
                            <TextBox x:Name="TxtEmail" Width="250" Background="{DynamicResource WindowBackground}" Foreground="{DynamicResource PrimaryText}" BorderBrush="{DynamicResource BorderColor}"/>
                        </StackPanel>

                        <Separator Margin="0,15,0,15"/>

                        <TextBlock Text="Налаштування" FontSize="18" FontWeight="Bold" Margin="0,0,0,10" Foreground="{DynamicResource PrimaryText}"/>

                        <StackPanel Orientation="Horizontal" Margin="0,5">
                            <TextBlock Text="Валюта:" Width="120" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryText}"/>
                            <ComboBox x:Name="CmbCurrency" Width="150" Background="{DynamicResource WindowBackground}" Foreground="{DynamicResource PrimaryText}" BorderBrush="{DynamicResource BorderColor}">
                                <ComboBoxItem Content="USD"/>
                                <ComboBoxItem Content="EUR"/>
                                <ComboBoxItem Content="UAH"/>
                                <ComboBoxItem Content="GBP"/>
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,5">
                            <TextBlock Text="Сповіщення:" Width="120" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryText}"/>
                            <CheckBox x:Name="ChkNotifications" Content="Enabled" VerticalAlignment="Center" Foreground="{DynamicResource PrimaryText}"/>
                        </StackPanel>
                        
                        
                        <StackPanel Orientation="Horizontal" Margin="0,5">
                            <TextBlock Text="Інтерфейс:" Width="120" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryText}"/>
                            <CheckBox x:Name="ThemeToggle" 
                                            Content="Темна тема"
                                            VerticalAlignment="Center"
                                            Foreground="{DynamicResource PrimaryText}"
                                            Checked="ThemeToggle_Checked"
                                            Unchecked="ThemeToggle_Unchecked"/>
                        </StackPanel>
                        
                        <Button x:Name="BtnSaveProfile" 
                                Content="Зберегти зміни" 
                                Width="150" Margin="0,20,0,0" 
                                Click="BtnSaveProfile_Click"
                                Background="{DynamicResource ButtonBackground}" 	
                                Foreground="{DynamicResource ButtonForeground}"/>


                        <Button x:Name="BtnLogout"
                                Content="Вийти з акаунту"
                                Width="150"
                                Margin="0,10,0,0"
                                Background="#E57373" 
                                Foreground="White"
                                Click="BtnLogout_Click"/>

                        <Button x:Name="BtnChangePassword" 	
                                Content="Змінити пароль" 	
                                Width="150" 		
                                Margin="0,10,0,0" 	
                                Click="BtnChangePassword_Click" 	
                                Background="{DynamicResource ButtonBackground}" 	
                                Foreground="{DynamicResource ButtonForeground}"/>
                        <Button x:Name="BtnDeleteAccount" 
                                Content="Видалити акаунт" 
                                Width="120" HorizontalAlignment="Left" 
                                Margin="8" 
                                Click="BtnDeleteAccount_Click"
                                Background="red" 
                                Foreground="White"/>

                    </StackPanel>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>