<Window x:Class="MoneyRules.UI.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:MoneyRules.UI.Windows"
        Title="MoneyRules" Height="500" Width="700"
        Background="{DynamicResource AppBackground}">
    <Grid>
        <TabControl x:Name="MainTabControl" Background="{DynamicResource AppBackground}">
            
            <TabItem Header="Завантаження файлу" Background="{DynamicResource AppBackground}">
                <local:FileUploadPage />
            </TabItem>

            <TabItem Header="Редагування даних" Background="{DynamicResource AppBackground}">
                <!-- Використовуємо Grid для точного позиціонування панелі сповіщень унизу праворуч -->
                <Grid>
                    <!-- Основний вміст вкладки "Редагування даних" -->
                    <StackPanel Margin="0,10,32,10">
                        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,0" Width="280" HorizontalAlignment="Left">
                            <StackPanel Margin="6">
                                <TextBlock Text="Дії" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryText}" Margin="0,0,0,8"/>
                                <Button Margin="0,4,0,0" MinHeight="42" Click="AddTransactionButton_Click" Style="{StaticResource PrimaryButton}">
                                    <TextBlock Text="Додати транзакцію" TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Center"/>
                                </Button>
                                <Button Margin="0,4,0,0" MinHeight="42" Style="{StaticResource {x:Type Button}}">
                                    <TextBlock Text="Видалити" TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Center"/>
                                </Button>
                                <Button Margin="0,4,0,0" MinHeight="42" Click="OpenHistory_Click" Style="{StaticResource {x:Type Button}}">
                                    <TextBlock Text="Переглянути історію" TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Center"/>
                                </Button>
                                <Button x:Name="BtnScheduledPayments" Margin="0,4,0,0" MinHeight="42" Click="BtnScheduledPayments_Click" Style="{StaticResource {x:Type Button}}">
                                    <TextBlock Text="Заплановані платежі" TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Center"/>
                                </Button>
                                <Button x:Name="OpenDuplicatePaymentWindowButton" Margin="0,4,0,0" MinHeight="42" Click="OpenDuplicatePaymentWindow_Click" Style="{StaticResource {x:Type Button}}">
                                    <TextBlock Text="Дублювати платіж" TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Center"/>
                                </Button>
                                <Separator Margin="0,8,0,8"/>
                                <Button x:Name="BtnExportPdf" MinHeight="42" FontWeight="SemiBold" Click="BtnExportPdf_Click" Style="{StaticResource AccentButton}">
                                    <TextBlock Text="Експорт PDF" TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Center"/>
                                </Button>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ======================================================= -->
                    <!-- ДОДАНО: Панель сповіщень про заплановані платежі -->
                    <!-- ======================================================= -->
                    <Border x:Name="NotificationPanelBorder"
                            Visibility="Collapsed" 
                            Background="{DynamicResource WindowBackground}" 
                            BorderBrush="#FFD700"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="12" 
                            Width="350"
                            HorizontalAlignment="Right" 
                            VerticalAlignment="Bottom"
                            Margin="20">

                        <StackPanel x:Name="NotificationPanelContent"> 
                            <TextBlock Text="🔔 Наближаються важливі платежі" 
                                       FontWeight="Bold" 
                                       Foreground="#B00020" 
                                       Margin="0,0,0,5"/>
                            
                            <Separator Margin="0,0,0,5"/>
                            
                            <TextBlock x:Name="NotificationText" 
                                       TextWrapping="Wrap" 
                                       Foreground="{DynamicResource PrimaryText}" 
                                       Text="Тут буде детальний список платежів."/>

                        </StackPanel>
                    </Border>
                    <!-- ======================================================= -->
                    
                </Grid>
            </TabItem>

            <TabItem Header="Візуалізація" Background="{DynamicResource AppBackground}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="10">
                    <StackPanel>
                        <!-- Фільтри в картці -->
                        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                            <StackPanel Margin="6">
                                <TextBlock Text="Фільтри" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryText}" Margin="0,0,0,8" FontSize="14"/>
                                
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <TextBlock Text="Рік:" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{DynamicResource PrimaryText}"/>
                                    <ComboBox x:Name="CmbChartYear" Grid.Column="1" SelectionChanged="CmbChartYear_SelectionChanged" />
                                    
                                    <TextBlock Text="Місяць:" Grid.Column="2" VerticalAlignment="Center" Margin="8,0,6,0" Foreground="{DynamicResource PrimaryText}"/>
                                    <ComboBox x:Name="CmbChartMonth" Grid.Column="3" SelectionChanged="CmbChartYear_SelectionChanged" />
                                    
                                    <StackPanel Grid.Column="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="8,0,0,0">
                                        <CheckBox x:Name="ChkMonthlyView" Content="По днях" VerticalAlignment="Center" Margin="0,0,8,0" Checked="ChkMonthlyView_CheckedChanged" Unchecked="ChkMonthlyView_CheckedChanged" Foreground="{DynamicResource PrimaryText}" />
                                        <Button Content="Оновити" Click="BtnRefreshChart_Click" Style="{StaticResource PrimaryButton}" Width="100"/>
                                    </StackPanel>
                                </Grid>
                                
                                <Separator Margin="0,8,0,8"/>
                                
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,0">
                                    <TextBlock Text="Місячний бюджет:" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{DynamicResource PrimaryText}"/>
                                    <TextBox Width="140" 
                                        Background="{DynamicResource WindowBackground}" 
                                        Foreground="{DynamicResource PrimaryText}" 
                                        BorderBrush="{DynamicResource BorderColor}"
                                        Text="{Binding MonthlyBudget, StringFormat=N2, UpdateSourceTrigger=PropertyChanged}"/>
                                    <Button Content="Зберегти" 
                                         Margin="8,0,0,0" 
                                         Background="{DynamicResource ButtonBackground}" 
                                         Foreground="{DynamicResource ButtonForeground}" 
                                         Command="{Binding SaveBudgetCommand}"
                                         Width="100"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Діаграма Дохід/Витрати -->
                        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                            <StackPanel Margin="6">
                                <TextBlock Text="Дохід / Витрати" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryText}" Margin="0,0,0,8" FontSize="14"/>
                                <Canvas x:Name="ChartCanvas" Height="280" Background="{DynamicResource AppBackground}" />
                                <TextBlock x:Name="TxtChartStatus" Margin="0,6,0,0" FontStyle="Italic" Foreground="{DynamicResource SecondaryText}"/>
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <Rectangle Width="14" Height="10" Fill="Green" Stroke="Black" StrokeThickness="0.5"/>
                                    <TextBlock Text=" Доходи" Margin="4,0,12,0" VerticalAlignment="Center" Foreground="{DynamicResource PrimaryText}" FontSize="12"/>
                                    <Rectangle Width="14" Height="10" Fill="Red" Stroke="Black" StrokeThickness="0.5"/>
                                    <TextBlock Text=" Витрати" Margin="4,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource PrimaryText}" FontSize="12"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Категорії: Top-5 + Вибрані -->
                        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                            <StackPanel Margin="6">
                                <TextBlock Text="Деталі по категоріях" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryText}" Margin="0,0,0,8" FontSize="14"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="240"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Orientation="Vertical" Margin="0,0,12,0">
                                        <TextBlock Text="Top-5 категорій" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryText}" Margin="0,0,0,6" FontSize="12"/>
                                        <Canvas x:Name="PieTop5Canvas" Height="200" Background="{DynamicResource AppBackground}" Margin="0,0,0,12" />
                                        
                                        <TextBlock Text="Вибрані категорії" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryText}" Margin="0,0,0,6" FontSize="12"/>
                                        <Canvas x:Name="PieSelectedCanvas" Height="200" Background="{DynamicResource AppBackground}" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Margin="0,0,0,0">
                                        <TextBlock Text="Легенда (Top-5)" FontWeight="Bold" Foreground="{DynamicResource PrimaryText}" FontSize="11" Margin="0,0,0,6"/>
                                        <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="100">
                                            <ItemsControl x:Name="PieTop5Legend">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Orientation="Horizontal" Margin="0,2,0,2">
                                                            <Rectangle Width="12" Height="10" Fill="{Binding Color}" Stroke="Black" StrokeThickness="0.5"/>
                                                            <TextBlock Text="{Binding Label}" VerticalAlignment="Center" Foreground="{DynamicResource PrimaryText}" FontSize="10" Margin="4,0,0,0" MaxWidth="160" TextTrimming="CharacterEllipsis"/>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>

                                        <Separator Margin="0,8,0,8" />

                                        <TextBlock Text="Легенда (Вибрані)" FontWeight="Bold" Foreground="{DynamicResource PrimaryText}" FontSize="11" Margin="0,0,0,6"/>
                                        <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="100">
                                            <ItemsControl x:Name="PieSelectedLegend">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Orientation="Horizontal" Margin="0,2,0,2">
                                                            <Rectangle Width="12" Height="10" Fill="{Binding Color}" Stroke="Black" StrokeThickness="0.5"/>
                                                            <TextBlock Text="{Binding Label}" VerticalAlignment="Center" Foreground="{DynamicResource PrimaryText}" FontSize="10" Margin="4,0,0,0" MaxWidth="160" TextTrimming="CharacterEllipsis"/>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </StackPanel>
                                </Grid>

                                <Separator Margin="0,12,0,12" />
                                
                                <TextBlock Text="Виберіть категорії (2–10):" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryText}" Margin="0,0,0,6" FontSize="12"/>
                                <ScrollViewer Height="100" VerticalScrollBarVisibility="Auto" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" Padding="4">
                                    <StackPanel x:Name="CategoryCheckboxes" />
                                </ScrollViewer>
                                <TextBlock x:Name="CategoryHintText" Text="Оберіть від 2 до 10 категорій для аналізу." Foreground="{DynamicResource SecondaryText}" Visibility="Collapsed" Margin="0,6,0,0" FontSize="11"/>
                            </StackPanel>
                        </Border>

                        <!-- Доходи vs Витрати -->
                        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,0">
                            <StackPanel Margin="6">
                                <TextBlock Text="Доходи vs Витрати" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryText}" Margin="0,0,0,8" FontSize="14"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="200"/>
                                    </Grid.ColumnDefinitions>
                                    <Canvas x:Name="IncomeExpenseCanvas" Grid.Column="0" Height="180" Background="{DynamicResource AppBackground}" />
                                    <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                        <TextBlock Text="Легенда" FontWeight="Bold" Foreground="{DynamicResource PrimaryText}" FontSize="11" Margin="0,0,0,6"/>
                                        <ItemsControl x:Name="IncomeExpenseLegend">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,4">
                                                        <Rectangle Width="12" Height="10" Fill="{Binding Color}" Stroke="Black" StrokeThickness="0.5"/>
                                                        <TextBlock Text="{Binding Label}" VerticalAlignment="Center" Foreground="{DynamicResource PrimaryText}" FontSize="11" Margin="4,0,0,0"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Підписка" Background="{DynamicResource AppBackground}">
                <StackPanel Margin="10">
                    <TextBlock Text="Активація преміум-підписки" Margin="0,0,0,5" Foreground="{DynamicResource PrimaryText}"/>
                    <Button Content="Активувати підписку" Width="200" Background="{DynamicResource ButtonBackground}" Foreground="{DynamicResource ButtonForeground}"/>
                    <TextBlock Text="Тут буде статус підписки" Margin="5" Foreground="{DynamicResource SecondaryText}"/>
                </StackPanel>
            </TabItem>

            <TabItem Header="Поради" Background="{DynamicResource AppBackground}">
                <StackPanel Margin="10">
                    <TextBlock Text="Персональні поради на основі ваших транзакцій" FontStyle="Italic" Foreground="{DynamicResource SecondaryText}"/>
                    <GroupBox Header="Поради щодо економії" Margin="0,10,0,0" Foreground="{DynamicResource PrimaryText}">
                        <StackPanel>
                            <ItemsControl x:Name="AdviceList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource CardStyle}" Margin="0,6,0,0">
                                            <TextBlock Text="{Binding}" TextWrapping="Wrap" Foreground="{DynamicResource PrimaryText}" Margin="6"/>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                            <Button x:Name="RefreshAdviceButton" Content="Оновити поради" Width="150" Margin="0,8,0,0" Click="RefreshAdviceButton_Click" Style="{StaticResource PrimaryButton}" />
                        </StackPanel>
                    </GroupBox>
                </StackPanel>
            </TabItem>

            <TabItem Header="Профіль" Background="{DynamicResource AppBackground}">
                <Grid Margin="20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Top">
                        <Border BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="10" Padding="5">
                            <Image x:Name="ProfileImage" Width="150" Height="150" Stretch="UniformToFill"/>
                        </Border>
                        <Button x:Name="BtnChangePhoto" 
                                Content="Змінити фото" 
                                Margin="0,10,0,0" 
                                Click="BtnChangePhoto_Click"
                                Background="{DynamicResource ButtonBackground}" 	
                                Foreground="{DynamicResource ButtonForeground}"/>
                        
                        <Border Background="{DynamicResource WindowBackground}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" 
                                CornerRadius="8" Margin="0,20,0,0" Width="200">
                            <StackPanel Margin="10">
                                <TextBlock Text="Курси валют" FontWeight="SemiBold" 
                                           FontSize="14" HorizontalAlignment="Center"
                                           Margin="0,0,0,10"
                                           Foreground="{DynamicResource PrimaryText}"/>
                                <TextBlock x:Name="TxtExchangeRates" TextWrapping="Wrap"
                                           FontFamily="Consolas"
                                           Foreground="{DynamicResource SecondaryText}"/>
                                <Button x:Name="BtnRefreshRates" Content="Оновити курси"
                                        Width="120" Margin="0,10,0,0"
                                        Background="{DynamicResource ButtonBackground}" Foreground="{DynamicResource ButtonForeground}"
                                        Padding="5" Click="BtnRefreshRates_Click">
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="4"/>
                                        </Style>
                                    </Button.Resources>
                                </Button>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="20,0,0,0" VerticalAlignment="Top">
                        <TextBlock Text="Інформація про користувача" FontSize="18" FontWeight="Bold" Margin="0,0,0,10" Foreground="{DynamicResource PrimaryText}"/>

                        <StackPanel Orientation="Horizontal" Margin="0,5">
                            <TextBlock Text="Ім'я:" Width="120" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryText}"/>
                            <TextBox x:Name="TxtName" Width="250" Background="{DynamicResource WindowBackground}" Foreground="{DynamicResource PrimaryText}" BorderBrush="{DynamicResource BorderColor}"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,5">
                            <TextBlock Text="Email:" Width="120" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryText}"/>
                            <TextBox x:Name="TxtEmail" Width="250" Background="{DynamicResource WindowBackground}" Foreground="{DynamicResource PrimaryText}" BorderBrush="{DynamicResource BorderColor}"/>
                        </StackPanel>

                        <Separator Margin="0,15,0,15"/>

                        <TextBlock Text="Налаштування" FontSize="18" FontWeight="Bold" Margin="0,0,0,10" Foreground="{DynamicResource PrimaryText}"/>

                        <StackPanel Orientation="Horizontal" Margin="0,5">
                            <TextBlock Text="Валюта:" Width="120" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryText}"/>
                            <ComboBox x:Name="CmbCurrency" Width="150" Background="{DynamicResource WindowBackground}" Foreground="{DynamicResource PrimaryText}" BorderBrush="{DynamicResource BorderColor}">
                                <ComboBoxItem Content="USD"/>
                                <ComboBoxItem Content="EUR"/>
                                <ComboBoxItem Content="UAH"/>
                                <ComboBoxItem Content="GBP"/>
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,5">
                            <TextBlock Text="Сповіщення:" Width="120" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryText}"/>
                            <CheckBox x:Name="ChkNotifications" Content="Enabled" VerticalAlignment="Center" Foreground="{DynamicResource PrimaryText}"/>
                        </StackPanel>
                        
                        
                        <StackPanel Orientation="Horizontal" Margin="0,5">
                            <TextBlock Text="Інтерфейс:" Width="120" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryText}"/>
                            <CheckBox x:Name="ThemeToggle" 
                                            Content="Темна тема"
                                            VerticalAlignment="Center"
                                            Foreground="{DynamicResource PrimaryText}"
                                            Checked="ThemeToggle_Checked"
                                            Unchecked="ThemeToggle_Unchecked"/>
                        </StackPanel>
                        
                        <Button x:Name="BtnSaveProfile" 
                                Content="Зберегти зміни" 
                                Width="150" Margin="0,20,0,0" 
                                Click="BtnSaveProfile_Click"
                                Background="{DynamicResource ButtonBackground}" 	
                                Foreground="{DynamicResource ButtonForeground}"/>


                        <Button x:Name="BtnLogout"
                                Content="Вийти з акаунту"
                                Width="150"
                                Margin="0,10,0,0"
                                Background="#E57373" 
                                Foreground="White"
                                Click="BtnLogout_Click"/>

                        <Button x:Name="BtnChangePassword" 	
                                Content="Змінити пароль" 	
                                Width="150" 		
                                Margin="0,10,0,0" 	
                                Click="BtnChangePassword_Click" 	
                                Background="{DynamicResource ButtonBackground}" 	
                                Foreground="{DynamicResource ButtonForeground}"/>
                        <Button x:Name="BtnDeleteAccount" 
                                Content="Видалити акаунт" 
                                Width="120" HorizontalAlignment="Left" 
                                Margin="8" 
                                Click="BtnDeleteAccount_Click"
                                Background="red" 
                                Foreground="White"/>

                    </StackPanel>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>