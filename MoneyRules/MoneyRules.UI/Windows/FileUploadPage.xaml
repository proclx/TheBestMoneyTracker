<UserControl x:Class="MoneyRules.UI.Windows.FileUploadPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Border Style="{StaticResource CardStyle}" Margin="20">

        <StackPanel>

            <Button Content="Завантажити файл (Standard)"
                    Width="260"
                    Style="{StaticResource PrimaryButton}"
                    Command="{Binding UploadDefaultCommand}" />

            <Button Content="Завантажити Monobank CSV"
                    Width="260"
                    Margin="0,10,0,0"
                    Style="{StaticResource {x:Type Button}}"
                    Command="{Binding UploadMonobankCommand}" />

            <Button Content="Завантажити ПриватБанк XLSX"
                    Width="260"
                    Margin="0,10,0,0"
                    Style="{StaticResource AccentButton}"
                    Command="{Binding UploadPrivatCommand}" />

            <TextBlock x:Name="StatusText"
                       Text="{Binding StatusText}"
                       Margin="0,15,0,0"
                       TextWrapping="Wrap"/>
        </StackPanel>

    </Border>

</UserControl>
