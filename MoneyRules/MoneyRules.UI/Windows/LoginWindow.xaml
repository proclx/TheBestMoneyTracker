<Window x:Class="MoneyRules.UI.Windows.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Увійти"
        Height="450"
        Width="400"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">

    <Grid Background="#f8f9fa">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="250">

            <!-- Кнопка Назад -->
            <Button Content="← Назад"
                    Width="80"
                    Margin="0,0,0,15"
                    HorizontalAlignment="Left"
                    Click="BackButton_Click"/>

            <TextBlock Text="Вхід"
                       FontSize="20"
                       FontWeight="Bold"
                       Margin="0,0,0,20"
                       TextAlignment="Center"/>

            <TextBlock Text="Email" Margin="0,0,0,3"/>
            <TextBox Name="EmailTextBox"
                     Height="30"
                     Margin="0,0,0,10"/>

            <TextBlock Text="Пароль" Margin="0,0,0,3"/>
            <PasswordBox Name="PasswordBox"
                         Height="30"
                         Margin="0,0,0,10"/>

            <CheckBox Name="RememberMeCheckBox"
                      Content="Запам'ятати мене"
                      Margin="0,0,0,15"
                      HorizontalAlignment="Left" />

            <Button Content="Увійти"
                    Width="100"
                    Height="35"
                    Background="#0078D7"
                    Foreground="White"
                    FontWeight="SemiBold"
                    Margin="0,0,0,10"
                    Click="LoginButton_Click"/>

            <!-- Панель для 2FA -->
            <StackPanel x:Name="TwoFactorPanel" Visibility="Collapsed" Margin="0,10,0,0">
                <TextBlock Text="Введіть код 2FA:"/>
                <TextBox Name="TwoFactorCodeTextBox" Height="30" Margin="0,5,0,10"/>
                <Button Content="Підтвердити 2FA"
                        Width="120"
                        HorizontalAlignment="Center"
                        Background="Orange"
                        Foreground="White"
                        Click="ConfirmTwoFactorButton_Click"/>
            </StackPanel>

            <TextBlock Text="Забули пароль?" Foreground="#0078D7" Cursor="Hand"
                       MouseDown="ForgotPassword_Click" Margin="0,10,0,0" />

        </StackPanel>
    </Grid>
</Window>


