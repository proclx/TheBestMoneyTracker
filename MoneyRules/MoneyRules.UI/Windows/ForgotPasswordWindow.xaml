<Window x:Class="MoneyRules.UI.Windows.ForgotPasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Відновлення паролю"
        Height="250" Width="400"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="#f6f8fb">

    <Border CornerRadius="10" Background="White" Padding="0" Margin="0">
        <Border.Effect>
            <DropShadowEffect BlurRadius="10" ShadowDepth="3" Opacity="0.4"/>
        </Border.Effect>

        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">

            <TextBlock Text="Введіть свій email"
                       FontSize="18"
                       FontWeight="Bold"
                       Margin="0,0,0,15"
                       HorizontalAlignment="Center"/>

            <Border CornerRadius="6" Background="#f0f3f8" BorderBrush="#ccc" BorderThickness="1" Margin="0,0,0,20">
                <TextBox x:Name="EmailTextBox"
                         Height="35"
                         Padding="8"
                         BorderThickness="0"
                         Background="Transparent"
                         FontSize="14"/>
            </Border>

            <Button Content="Надіслати код"
                    Height="40"
                    FontSize="16"
                    Background="#4CAF50"
                    Foreground="White"
                    BorderThickness="0"
                    Cursor="Hand"
                    Click="SendCode_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="8"
                                Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>

        </StackPanel>
    </Border>
</Window>


