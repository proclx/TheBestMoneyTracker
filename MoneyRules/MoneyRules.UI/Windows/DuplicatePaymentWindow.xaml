<Window x:Class="MoneyRules.UI.Windows.DuplicatePaymentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Дублювати платіж" Height="500" Width="650"
        WindowStartupLocation="CenterOwner"
        Loaded="Window_Loaded">

    <Grid Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Оберіть платіж для дублювання:"
                   FontSize="16" FontWeight="SemiBold" />

        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,10,0,10">
            <DataGrid x:Name="transactionsDataGrid"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      SelectionMode="Single"
                      SelectionChanged="TransactionsDataGrid_SelectionChanged">

                <DataGrid.Columns>
                    <DataGridTextColumn Header="Дата"
                                        Binding="{Binding Date, StringFormat='dd.MM.yyyy'}" Width="Auto"/>
                    <DataGridTextColumn Header="Категорія"
                                        Binding="{Binding Category.Name}" Width="*"/>
                    <DataGridTextColumn Header="Опис" Binding="{Binding Description}" Width="*"/>
                    <DataGridTextColumn Header="Сума"
                                        Binding="{Binding Amount, StringFormat='N2'}" Width="Auto"/>
                </DataGrid.Columns>

            </DataGrid>
        </Border>

        <!-- Нова сума -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <TextBlock Text="Нова сума:" VerticalAlignment="Center"/>
            <TextBox x:Name="AmountTextBox" Width="150"/>
        </StackPanel>

        <!-- Кнопки -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Зберегти дублікат" Width="170"
                    Style="{StaticResource PrimaryButton}"
                    Click="SaveButton_Click"/>

            <Button Content="Відміна" Width="100"
                    Style="{StaticResource {x:Type Button}}"
                    Click="CancelButton_Click"/>
        </StackPanel>

    </Grid>
</Window>
