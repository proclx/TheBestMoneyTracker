<Window x:Class="MoneyRules.UI.Windows.DeleteAccountWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Delete Account" Height="250" Width="350" WindowStartupLocation="CenterScreen">
    <StackPanel Margin="20">
        <TextBlock Text="Введіть email:"/>
        <TextBox x:Name="EmailTextBox" Margin="0,5,0,10"/>

        <TextBlock Text="Введіть пароль:"/>
        <PasswordBox x:Name="PasswordBox" Margin="0,5,0,20"/>

        <Button Content="Видалити акаунт" 
                Width="150" HorizontalAlignment="Center" 
                                Background="red" 
                                Foreground="White"
                Click="ConfirmDeleteButton_Click"/>
    </StackPanel>
</Window>
