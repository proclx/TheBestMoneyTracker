<Window x:Class="MoneyRules.UI.Windows.ScheduledPaymentsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Заплановані Платежі" 
        Height="550" 
        Width="950"
        WindowStartupLocation="CenterScreen"
        Background="#F0F2F5">

    <Window.Resources>
        <SolidColorBrush x:Key="PrimaryColor" Color="#4A90E2"/>
        <SolidColorBrush x:Key="PrimaryHoverColor" Color="#357ABD"/>
        <SolidColorBrush x:Key="PrimaryPressColor" Color="#2A629A"/>
        <SolidColorBrush x:Key="GrayText" Color="#555555"/>
        <SolidColorBrush x:Key="SubtleBackground" Color="#E8E8E8"/>
        <SolidColorBrush x:Key="ErrorColor" Color="#DC3545"/>
        <SolidColorBrush x:Key="ErrorHoverColor" Color="#C82333"/>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="36"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="{StaticResource PrimaryColor}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                CornerRadius="6"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource PrimaryHoverColor}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource PrimaryPressColor}"/>
                                <Setter Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.98" ScaleY="0.98" CenterX="100" CenterY="18"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernHeaderStyle" TargetType="GridViewColumnHeader">
            <Setter Property="Background" Value="{StaticResource SubtleBackground}"/>
            <Setter Property="Foreground" Value="{StaticResource GrayText}"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E0E0E0"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ModernListViewItemStyle" TargetType="ListViewItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="BorderBrush" Value="#EEEEEE"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#E6F0FF"/>
                    <Setter Property="Foreground" Value="Black"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F5F5F5"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DeleteButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
            <Setter Property="Background" Value="{StaticResource ErrorColor}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource ErrorHoverColor}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,0,0,15">

            <Button Content="ДОДАТИ" 
                    Style="{StaticResource PrimaryButtonStyle}" 
                    Width="120"
                    Click="BtnAdd_Click" 
                    x:Name="BtnAdd"/>

            <Button Content="РЕДАГУВАТИ" 
                    Style="{StaticResource PrimaryButtonStyle}" 
                    Width="140"
                    Click="BtnEdit_Click" 
                    x:Name="BtnEdit"/>

            <Button Content="ВИДАЛИТИ" 
                    Style="{StaticResource DeleteButtonStyle}" 
                    Width="120"
                    Click="BtnDelete_Click" 
                    x:Name="BtnDelete"/>

        </StackPanel>

        <ListView Grid.Row="1" 
                  x:Name="PaymentsListView" 
                  BorderBrush="#D1D5DB" 
                  BorderThickness="1" 
                  ItemContainerStyle="{StaticResource ModernListViewItemStyle}">

            <ListView.View>
                <GridView ColumnHeaderContainerStyle="{StaticResource ModernHeaderStyle}">
                    <GridViewColumn Header="Опис" DisplayMemberBinding="{Binding Description}" Width="250" />
                    <GridViewColumn Header="Сума" DisplayMemberBinding="{Binding Amount, StringFormat={}{0:C}}" Width="100" />
                    <GridViewColumn Header="Частота" DisplayMemberBinding="{Binding Frequency}" Width="100" />
                    <GridViewColumn Header="Інтервал" DisplayMemberBinding="{Binding Interval}" Width="80" />
                    <GridViewColumn Header="Дата Початку" DisplayMemberBinding="{Binding StartDate, StringFormat={}{0:dd.MM.yyyy}}" Width="140" />
                    <GridViewColumn Header="Дата Закінчення" DisplayMemberBinding="{Binding EndDate, StringFormat={}{0:dd.MM.yyyy}}" Width="140" />
                    <GridViewColumn Header="Категорія" DisplayMemberBinding="{Binding Category.Name}" Width="120" />
                </GridView>
            </ListView.View>

        </ListView>

    </Grid>
</Window>