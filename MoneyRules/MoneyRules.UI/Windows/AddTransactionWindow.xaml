<Window x:Class="MoneyRules.UI.Windows.AddTransactionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        Title="Додати транзакцію" Height="420" Width="430"
        WindowStartupLocation="CenterOwner"
        Background="#FAFAFA">

    <Window.Resources>

        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="0,5,0,15"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="BorderBrush" Value="#C0C0C0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Width" Value="250"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="BorderBrush" Value="#4A90E2"/>
                    <Setter Property="BorderThickness" Value="2"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Стиль для Button -->
        <Style TargetType="Button">
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="Width" Value="100"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#4A90E2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                BorderBrush="#3F7DC1"
                                BorderThickness="1">

                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>

                        <!-- Тригери -->
                        <ControlTemplate.Triggers>
                            <!-- Hover -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#6AA8F2"/>
                            </Trigger>
                            <!-- Disabled -->
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#CCCCCC"/>
                                <Setter Property="Foreground" Value="#888"/>
                            </Trigger>
                        </ControlTemplate.Triggers>

                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Стиль для Label/TextBlock -->
        <Style TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,5,0,0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <!-- Стиль для ComboBox -->
        <Style TargetType="ComboBox">
            <Setter Property="Margin" Value="0,5,0,15"/>
            <Setter Property="Width" Value="250"/>
            <Setter Property="Padding" Value="6"/>
        </Style>

    </Window.Resources>

    <!-- ============================== -->
    <!--      ОСНОВНИЙ ІНТЕРФЕЙС         -->
    <!-- ============================== -->

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ======= Сума ======= -->
        <StackPanel Orientation="Horizontal">
            <TextBlock Text="Сума:" Width="120"/>
            <TextBox x:Name="AmountTextBox"/>
        </StackPanel>

        <!-- ======= Категорія ======= -->
        <StackPanel Grid.Row="1" Orientation="Horizontal">
            <TextBlock Text="Категорія:" Width="120"/>
            <TextBox x:Name="CategoryTextBox"/>
        </StackPanel>

        <!-- ======= Тип ======= -->
        <StackPanel Grid.Row="2" Orientation="Horizontal">
            <TextBlock Text="Тип:" Width="120"/>
            <ComboBox x:Name="TypeComboBox">
                <ComboBoxItem Content="Дохід"/>
                <ComboBoxItem Content="Витрата"/>
            </ComboBox>
        </StackPanel>

        <!-- ======= Дата ======= -->
        <StackPanel Grid.Row="3" Orientation="Horizontal">
            <TextBlock Text="Дата:" Width="120"/>
            <DatePicker x:Name="DatePicker"
                        Width="250"
                        SelectedDate="{x:Static sys:DateTime.Now}"/>
        </StackPanel>

        <!-- ======= Опис ======= -->
        <StackPanel Grid.Row="4" Orientation="Horizontal">
            <TextBlock Text="Опис:" Width="120"/>
            <TextBox x:Name="DescriptionTextBox"/>
        </StackPanel>

        <!-- ======= КНОПКИ ======= -->
        <StackPanel Grid.Row="5"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,30,0,0">
            <Button Content="OK" Click="OkButton_Click"/>
            <Button Content="Відміна" Background="#C94A4A" Click="CancelButton_Click"/>
        </StackPanel>

    </Grid>
</Window>
