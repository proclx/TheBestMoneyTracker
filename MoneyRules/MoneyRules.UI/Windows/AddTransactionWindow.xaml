<Window x:Class="MoneyRules.UI.Windows.AddTransactionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Додати транзакцію" 
        Height="520" Width="450" 
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#F0F2F5">

    <Window.Resources>
        <!-- ОСНОВНІ КОЛЬОРИ -->
        <SolidColorBrush x:Key="PrimaryColor" Color="#4CAF50"/>
        <SolidColorBrush x:Key="PrimaryHoverColor" Color="#43A047"/>
        <SolidColorBrush x:Key="PrimaryPressColor" Color="#2E7D32"/>
        <SolidColorBrush x:Key="GrayText" Color="#555555"/>

        <!-- СТИЛЬ ДЛЯ МІТОК (Labels) -->
        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <!-- ЗМЕНШЕНО з 14 -->
            <Setter Property="Foreground" Value="{StaticResource GrayText}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="Margin" Value="0,0,15,0"/>
            <Setter Property="FontWeight" Value="Medium"/>
        </Style>

        <!-- УНІВЕРСАЛЬНИЙ ШАБЛОН РАМКИ ВВОДУ -->
        <Style x:Key="InputBaseStyle" TargetType="Control">
            <Setter Property="Height" Value="32"/>
            <!-- ЗМЕНШЕНО з 40 -->
            <Setter Property="FontSize" Value="12"/>
            <!-- ЗМЕНШЕНО з 14 -->
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <!-- Відступи менші -->
        </Style>

        <!-- СТИЛЬ TEXTBOX -->
        <Style x:Key="ModernTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource InputBaseStyle}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border"
                                CornerRadius="4" 
                                Background="White"
                                BorderBrush="#D1D5DB"
                                BorderThickness="1">
                            <!-- Рамка тонша -->
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="false" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#A0A0A0"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource PrimaryColor}"/>
                                <Setter TargetName="border" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#4CAF50" BlurRadius="4" ShadowDepth="0" Opacity="0.2"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- СТИЛЬ COMBOBOX -->
        <Style x:Key="ModernComboBoxStyle" TargetType="ComboBox" BasedOn="{StaticResource InputBaseStyle}">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Style.Resources>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="4"/>
                </Style>
            </Style.Resources>
        </Style>

        <!-- СТИЛЬ DATEPICKER -->
        <Style x:Key="ModernDatePickerStyle" TargetType="DatePicker" BasedOn="{StaticResource InputBaseStyle}">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <!-- СТИЛЬ КНОПКИ ЗБЕРЕЖЕННЯ (Primary) -->
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="36"/>
            <!-- ЗМЕНШЕНО з 45 -->
            <Setter Property="FontSize" Value="13"/>
            <!-- ЗМЕНШЕНО з 16 -->
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="{StaticResource PrimaryColor}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                CornerRadius="6"
                                Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource PrimaryHoverColor}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource PrimaryPressColor}"/>
                                <Setter Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.98" ScaleY="0.98" CenterX="100" CenterY="18"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#CCCCCC"/>
                                <Setter Property="Foreground" Value="#888888"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSaving}" Value="True">
                    <Setter Property="Content" Value="Збереження..."/>
                    <Setter Property="IsEnabled" Value="False"/>
                    <Setter Property="Cursor" Value="Wait"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- СТИЛЬ КНОПКИ СКАСУВАННЯ (Link) -->
        <Style x:Key="LinkButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#777"/>
            <Setter Property="FontSize" Value="12"/>
            <!-- ЗМЕНШЕНО -->
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="15,0,0,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}">
                            <TextBlock Text="{TemplateBinding Content}" 
                                       TextDecorations="Underline"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#333"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <!-- Основний контейнер -->
    <Grid>
        <!-- Зменшено внутрішні відступи контейнера -->
        <Border Background="White" CornerRadius="12" Width="400" VerticalAlignment="Center" Padding="25">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" ShadowDepth="5" Opacity="0.1"/>
            </Border.Effect>

            <StackPanel>
                <!-- Заголовок -->
                <TextBlock Text="Нова транзакція" 
                           FontSize="18" FontWeight="Bold" Foreground="#333" 
                           HorizontalAlignment="Center" Margin="0,0,0,20"/>
                <!-- ЗМЕНШЕНО шрифт і відступ -->

                <!-- Форма вводу -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" MinWidth="80"/>
                        <!-- ЗМЕНШЕНО MinWidth -->
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- 1. Сума -->
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Сума:" Style="{StaticResource LabelStyle}"/>
                    <TextBox Grid.Row="0" Grid.Column="1" 
                             Text="{Binding Amount, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:N2}}"
                             Style="{StaticResource ModernTextBoxStyle}"/>

                    <!-- 2. Категорія -->
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Категорія:" Style="{StaticResource LabelStyle}"/>
                    <ComboBox Grid.Row="1" Grid.Column="1" 
                              ItemsSource="{Binding AvailableCategories}"
                              SelectedItem="{Binding SelectedCategory}"
                              DisplayMemberPath="Name"
                              Style="{StaticResource ModernComboBoxStyle}"/>

                    <!-- 3. Тип -->
                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Тип:" Style="{StaticResource LabelStyle}"/>
                    <ComboBox Grid.Row="2" Grid.Column="1" 
                              ItemsSource="{Binding TransactionTypes}"
                              SelectedItem="{Binding SelectedType}"
                              Style="{StaticResource ModernComboBoxStyle}"/>

                    <!-- 4. Дата -->
                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Дата:" Style="{StaticResource LabelStyle}"/>
                    <DatePicker Grid.Row="3" Grid.Column="1" 
                                SelectedDate="{Binding Date}"
                                Style="{StaticResource ModernDatePickerStyle}"/>

                    <!-- 5. Опис (Multiline) -->
                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Опис:" Style="{StaticResource LabelStyle}" VerticalAlignment="Top" Margin="0,8,15,0"/>
                    <TextBox Grid.Row="4" Grid.Column="1" 
                             Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" 
                             TextWrapping="Wrap" AcceptsReturn="True"
                             Style="{StaticResource ModernTextBoxStyle}"
                             Height="60" 
                             VerticalContentAlignment="Top" Padding="8,8"/>
                    <!-- ЗМЕНШЕНО Height -->
                </Grid>

                <!-- Повідомлення про статус -->
                <TextBlock Text="{Binding StatusMessage}" 
                           Foreground="#4CAF50" FontStyle="Italic" FontSize="12"
                           HorizontalAlignment="Center" Margin="0,5,0,10"/>

                <!-- Кнопки керування -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,5,0,0">

                    <!-- Кнопка збереження -->
                    <Button Content="ЗБЕРЕГТИ" 
                            Command="{Binding SaveTransactionCommand}"
                            CommandParameter="{Binding RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Width="120"/>
                    <!-- ЗМЕНШЕНО ширину -->

                    <!-- Кнопка скасування -->
                    <Button Content="Скасувати" 
                            Click="CancelButton_Click"
                            Style="{StaticResource LinkButtonStyle}"
                            IsCancel="True"/>
                </StackPanel>

            </StackPanel>
        </Border>
    </Grid>
</Window>