<Window x:Class="MoneyRules.UI.Windows.AddTransactionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Додати транзакцію" Height="400" Width="400" WindowStartupLocation="CenterOwner">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Text="Сума:" Margin="0,5,10,5" VerticalAlignment="Center"/>
        <TextBox Grid.Row="0" Grid.Column="1" 
                 Text="{Binding Amount, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:N2}}"
                 Margin="0,5,0,5" Padding="3"/>

        <TextBlock Grid.Row="1" Grid.Column="0" Text="Категорія:" Margin="0,5,10,5" VerticalAlignment="Center"/>
        <ComboBox Grid.Row="1" Grid.Column="1" 
                  ItemsSource="{Binding AvailableCategories}"
                  SelectedItem="{Binding SelectedCategory}"
                  DisplayMemberPath="Name"
                  Margin="0,5,0,5" Padding="3"/>

        <TextBlock Grid.Row="2" Grid.Column="0" Text="Тип:" Margin="0,5,10,5" VerticalAlignment="Center"/>
        <ComboBox Grid.Row="2" Grid.Column="1" 
                  ItemsSource="{Binding TransactionTypes}"
                  SelectedItem="{Binding SelectedType}"
                  Margin="0,5,0,5" Padding="3"/>

        <TextBlock Grid.Row="3" Grid.Column="0" Text="Дата:" Margin="0,5,10,5" VerticalAlignment="Center"/>
        <DatePicker Grid.Row="3" Grid.Column="1" 
                    SelectedDate="{Binding Date}"
                    Margin="0,5,0,5" Padding="3"/>

        <TextBlock Grid.Row="4" Grid.Column="0" Text="Опис:" Margin="0,5,10,5" VerticalAlignment="Top"/>
        <TextBox Grid.Row="4" Grid.Column="1" 
                 Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" 
                 TextWrapping="Wrap" Height="50"
                 Margin="0,5,0,15" Padding="3"/>

        <TextBlock Grid.Row="5" Grid.ColumnSpan="2" 
                   Text="{Binding StatusMessage}" 
                   Foreground="DarkGreen" FontStyle="Italic"
                   Margin="0,0,0,10"/>

        <StackPanel Grid.Row="6" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right">

            <Button Command="{Binding SaveTransactionCommand}" 
                    CommandParameter="{Binding RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                    Width="80" Margin="5" Height="25" Background="#2196F3" Foreground="White">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Content" Value="OK"/>
                        <Setter Property="IsEnabled" Value="{Binding SaveTransactionCommand.CanExecute}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSaving}" Value="True">
                                <Setter Property="Content" Value="Збереження..."/>
                                <Setter Property="IsEnabled" Value="False"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>

            <Button Content="Відміна" Width="80" Margin="5" Click="CancelButton_Click" Height="25"/>
        </StackPanel>
    </Grid>
</Window>
