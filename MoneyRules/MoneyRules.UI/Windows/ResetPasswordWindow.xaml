<Window x:Class="MoneyRules.UI.Windows.ResetPasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Зміна пароля"
        Height="300" Width="400"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="#f6f8fb">

    <Border CornerRadius="10" Background="White" Padding="0" Margin="0">
        <Border.Effect>
            <DropShadowEffect BlurRadius="10" ShadowDepth="3" Opacity="0.4"/>
        </Border.Effect>

        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">

            <TextBlock Text="Введіть новий пароль"
                       FontSize="18"
                       FontWeight="Bold"
                       Margin="0,0,0,15"
                       HorizontalAlignment="Center"/>

            <PasswordBox x:Name="NewPasswordBox"
                         Height="35"
                         Margin="0,0,0,10"
                         Padding="8"
                         FontSize="14"/>

            <PasswordBox x:Name="ConfirmPasswordBox"
                         Height="35"
                         Margin="0,0,0,20"
                         Padding="8"
                         FontSize="14"/>

            <Button Content="Змінити пароль"
                    Height="40"
                    FontSize="16"
                    Background="#4CAF50"
                    Foreground="White"
                    BorderThickness="0"
                    Cursor="Hand"
                    Click="ChangePassword_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="8" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </StackPanel>
    </Border>
</Window>
