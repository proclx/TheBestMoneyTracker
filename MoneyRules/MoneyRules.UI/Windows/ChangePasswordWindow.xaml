<Window x:Class="MoneyRules.UI.Windows.ChangePasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Змінити пароль"
        Height="300"
        Width="400"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">

    <Grid Margin="20">
        <StackPanel>
            <TextBlock Text="Старий пароль:" Margin="0,0,0,5"/>
            <PasswordBox x:Name="OldPasswordBox" Height="30" Margin="0,0,0,10"/>

            <TextBlock Text="Новий пароль:" Margin="0,0,0,5"/>
            <PasswordBox x:Name="NewPasswordBox" Height="30" Margin="0,0,0,10"/>

            <TextBlock Text="Підтвердження нового пароля:" Margin="0,0,0,5"/>
            <PasswordBox x:Name="ConfirmPasswordBox" Height="30" Margin="0,0,0,20"/>

            <Button Content="Змінити пароль"
                    Click="ChangePassword_Click"
                    Height="35"
                    Background="#2196F3"
                    Foreground="White"/>
        </StackPanel>
    </Grid>
</Window>

